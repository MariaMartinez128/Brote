# Copia este archivo como .env y rellena tus valores (NUNCA subas .env a GitHub)

# Obligatoria: cadena de conexión de MongoDB (Atlas o local)
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/Brote?retryWrites=true&w=majority
PORT=3000

# Obligatoria: texto largo y aleatorio (mínimo 32 caracteres) para firmar las sesiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Email del administrador. Quien se registre con ese correo será admin (puede ver/borrar usuarios, etc.).
# Si lo dejas vacío, el primer usuario registrado es admin.
ADMIN_EMAIL=tu-correo@gmail.com

# Opcional: confirmación de cuenta y recuperación de contraseña por correo. Si no defines NINGUNO de los dos
# métodos, las cuentas se confirman solas al registrarse y el administrador puede restablecer contraseñas.
#
# Método A (recomendado, Brevo): crea una cuenta gratuita en brevo.com, verifica tu remitente y genera una clave SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Correo remitente: debe estar verificado en Brevo (sección Senders)
EMAIL_FROM=
#
# Método B (Gmail): contraseña de aplicación de Gmail
EMAIL_USER=
EMAIL_PASS=

# Opcional: ID de cliente de Google para el botón «Continuar con Google» (ver README). No es un secreto.
GOOGLE_CLIENT_ID=

# URL pública de la app (se usa en los enlaces de los correos)
BASE_URL=http://localhost:3000

# Opcional: fuerza (true) o desactiva (false) la cookie "secure". Por defecto es true en producción (NODE_ENV=production).
# Ponlo en false solo si pruebas el contenedor Docker en http://localhost.
# COOKIE_SECURE=false

# Opcional, solo para los tests: base de datos de pruebas VACÍA (se borra). Si no se define, usan MongoDB en memoria.
# MONGO_TEST_URI=mongodb://127.0.0.1:27017/brote_test
