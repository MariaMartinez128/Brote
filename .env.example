# Copia este archivo como .env y rellena tus valores (NUNCA subas .env a GitHub)
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/Brote?retryWrites=true&w=majority
PORT=3000

# Obligatoria: texto largo y aleatorio para firmar las sesiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Email del administrador (puede ver/borrar usuarios). Si lo dejas vacío, el primer registrado es admin.
ADMIN_EMAIL=tu-correo@gmail.com

# Opcional: confirmación de cuenta por correo (contraseña de aplicación de Gmail).
# Si no se definen EMAIL_USER y EMAIL_PASS, las cuentas se confirman automáticamente al registrarse.
EMAIL_USER=
EMAIL_PASS=
# URL pública de la app (se usa en el enlace del correo)
BASE_URL=http://localhost:3000
